# Base de datos (RDS Aurora PostgreSQL — autenticación por IAM, SIN password fija)
DB_HOST=database-1.cluster-cr0i0agomnun.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
AWS_REGION=us-east-2

# Perfil de AWS CLI a usar en desarrollo local (el mismo que usa DBeaver).
# En producción (EC2/ECS con IAM role) se deja vacío y usa el role de la instancia.
AWS_PROFILE=default

# Clave para firmar los JWT de sesión. Genera una propia con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
